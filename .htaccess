# =========================================================
# PPC Growth Expert - Server Configuration (.htaccess)
# =========================================================

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Enforce Non-WWW Canonical Domain
RewriteCond %{HTTP_HOST} ^www\.ppcgrowthexpert\.com$ [NC]
RewriteRule ^(.*)$ https://ppcgrowthexpert.com/$1 [L,R=301]

# Dynamic Blog Hyphenated Prefix Redirect (/blog-xyz.html -> /blog/xyz.html, only if file does not exist)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^blog-(.*)\.html$ /blog/$1.html [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^blog-(.*)/?$ /blog/$1.html [R=301,L]

# Cloudflare Email Protection Redirect
RewriteRule ^cdn-cgi/l/email-protection /contact.html [R=301,L]
</IfModule>

