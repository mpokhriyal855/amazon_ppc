# =========================================================
# PPC Growth Expert - Server Configuration (.htaccess)
# =========================================================

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Enforce Non-WWW Canonical Domain
RewriteCond %{HTTP_HOST} ^www\.ppcgrowthexpert\.com$ [NC]
RewriteRule ^(.*)$ https://ppcgrowthexpert.com/$1 [L,R=301]
</IfModule>

# =========================================================
# 1. 301 PERMANENT REDIRECTS (Live Matching Targets)
# =========================================================

# Consolidated Training Folder Standard
Redirect 301 /amazon-ecommerce-training.html /amazon-ecommerce-training/

# Legal & Policy URLs
Redirect 301 /privacy.html /privacy-policy.html
Redirect 301 /disclaimer.html /terms.html

# Service Slugs & Variations
Redirect 301 /services.html /services/
Redirect 301 /services/services.html /services/
Redirect 301 /services/amazon-ppc-management.html /services/amazon-ppc-management-services.html
Redirect 301 /services/amazon-account-management.html /services/amazon-account-management-services-india.html
Redirect 301 /amazon-ppc-management-services-delhi /services/amazon-ppc-management-services-delhi.html
Redirect 301 /amazon-ppc-management-services-delhi/ /services/amazon-ppc-management-services-delhi.html
Redirect 301 /services/amazon-ppc-management-services-delhi /services/amazon-ppc-management-services-delhi.html

# Calculators & Resources
Redirect 301 /calculators/amazon-conversion-rate-calculator.html /calculators/amazon-ppc-conversion-rate-calculator.html
Redirect 301 /resources.html /calculators/
Redirect 301 /calculators/resources.html /calculators/
Redirect 301 /free-amazon-listing-optimisation-tool.html /calculators/ai-amazon-listing-generator.html

# Blog Aliases
Redirect 301 /blog/blog.html /blog/


# =========================================================
# 2. 410 GONE (Permanently Deleted / Will Not Go Live)
# Informs Google crawler to drop dead URLs from index immediately
# =========================================================

Redirect gone /services/amazon-advertising-audit.html
Redirect gone /services/amazon-listing-optimization.html
Redirect gone /services/amazon-seller-central-audit.html
Redirect gone /services/amazon-dsp-advertising.html
Redirect gone /services/international-marketplace-expansion.html


# =========================================================
# 3. Custom 404 Error Page Handler
# =========================================================
ErrorDocument 404 /404.html

# =========================================================
# 4. BROWSER CACHING (EFFICIENT CACHE LIFETIMES)
# =========================================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML Documents (1 Hour)
    ExpiresByType text/html "access plus 1 hour"

    # CSS & JavaScript (1 Year - versioned with query strings)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images (1 Year - static assets)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Webfonts (1 Year)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # 1 Year Browser Cache for Static Assets (Images, CSS, JS, Webfonts)
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|css|js|woff2?|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # HTML Documents (1 Hour, revalidate)
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>


